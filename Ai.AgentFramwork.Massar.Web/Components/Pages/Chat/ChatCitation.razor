@using System.Web
@using Ai.AgentFramwork.Massar.Web.DBModels
@using Ai.AgentFramwork.Massar.Web.Services.Chat
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ChatAttachmentStore AttachmentStore

@if (!string.IsNullOrWhiteSpace(viewerUrl))
{
    <a href="@viewerUrl" target="_blank" class="citation">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
        </svg>
        <div class="citation-content">
            <div class="citation-file">@File</div>
           @*  <div>@Quote</div> *@
            @* <div title="@Quote">@ShortQuote</div> *@
        </div>
    </a>
}




@code {
    [Parameter] public required string File { get; set; }
    [Parameter] public string? Quote { get; set; }

    private string? viewerUrl;

    // Prevent duplicate blob saves
    private static readonly Dictionary<string, string> FileUrlCache = new();

    protected override async Task OnParametersSetAsync()
    {
        viewerUrl = null;

        if (string.IsNullOrWhiteSpace(File))
            return;

        var isMd = File.EndsWith(".md", StringComparison.OrdinalIgnoreCase);
        var isPdf = File.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
        if (!isMd && !isPdf)
            return;

        if (FileUrlCache.TryGetValue(File, out var cachedUrl))
        {
            viewerUrl = BuildViewerUrl(cachedUrl);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var docId = await db.Documents
            .Where(d => d.OriginalFileName == File || d.SourceName == File)
            .Select(d => d.DocumentId)
            .FirstOrDefaultAsync();

        if (docId == Guid.Empty)
            return;

        var fileRow = await db.DocumentFiles
            .Where(f => f.DocumentId == docId)
            .OrderByDescending(f => f.CreatedUtc)
            .Select(f => new { f.FileName, f.ContentType, f.FileContent })
            .FirstOrDefaultAsync();

        if (fileRow is null)
            return;

        var att = await AttachmentStore.SaveAssistantFileAsync(
            fileRow.FileName,
            fileRow.ContentType,
            fileRow.FileContent);

        FileUrlCache[File] = att.StorageUrl;
        viewerUrl = BuildViewerUrl(att.StorageUrl);
    }

    private string ShortQuote => TruncateOneLine(Quote, 140);

    private static string TruncateOneLine(string? s, int max)
    {
        if (string.IsNullOrWhiteSpace(s)) return "";
        var one = s.Replace("\r", " ").Replace("\n", " ").Trim();
        return one.Length <= max ? one : one[..max] + "…";
    }

    // private string BuildViewerUrl(string fileUrl)
    // {
    //     var encodedFile = HttpUtility.UrlEncode(fileUrl);

    //     if (File.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
    //     {
    //         return $"lib/markdown_viewer/viewer.html?file={encodedFile}#:~:text={Uri.EscapeDataString(Quote ?? "")}";
    //     }

    //     if (File.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
    //     {
    //         var search = Quote?.Trim('.', ',', ' ', '\n', '\r', '\t', '"', '\'');
    //         return $"lib/pdf_viewer/viewer.html?file={encodedFile}#search={HttpUtility.UrlEncode(search)}&phrase=true";
    //     }

    //     return string.Empty;
    // }

    private string BuildViewerUrl(string fileUrl)
    {
        // fileUrl will be like "/api/chat/attachments/{guid}"
        var safeFile = Uri.EscapeDataString(fileUrl);

        var q = (Quote ?? "")
            .Replace("\r", " ")
            .Replace("\n", " ")
            .Trim(' ', '.', ',', '"', '\'', '\t');

        if (q.Length > 80)
            q = q[..80];

        if (File.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
        {
            var textFrag = Uri.EscapeDataString(q);
            return $"lib/markdown_viewer/viewer.html?file={safeFile}#:~:text={textFrag}";
        }

        if (File.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            var search = Uri.EscapeDataString(q);
            return $"lib/pdf_viewer/viewer.html?file={safeFile}#search={search}&phrase=true";
        }

        return string.Empty;
    }

}