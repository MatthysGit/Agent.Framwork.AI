@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid ConversationId { get; set; }

    // Supports both legacy <!--TOOL:...--> and markdown comment [//]: # (TOOL:...).
    private static readonly Regex ToolMarkerRegex =
        new(@"(?:<!--\s*TOOL:(?<type>[^:]+):(?<b64>[^>]+?)\s*-->)|(?:\[\s*\/\/\s*\]\s*:\s*#\s*\(\s*TOOL:(?<type2>[^:]+):(?<b642>[^)]+?)\s*\)\s*)",
            RegexOptions.Compiled | RegexOptions.IgnoreCase | RegexOptions.Singleline);

    private bool _busy = true;
    private bool _loadedOnce;
    private string? _error;

    private string _emailPreviewHtml = "";
    private object? _result;

    private string _emailTo = "";
    private string _emailCc = "";
    private string _emailSubject = "";
    private string _emailMarkdown = "";

    private string? _signatureName;

    private bool _sendingEmail;
    private string? _emailSendError;
    private string? _emailSendSuccess;

    private string? _draftSaveError;
    private string? _draftSaveSuccess;
    private string? _draftWebLink;

    private bool _canSendEmail =>
        SplitEmails(_emailTo).Length > 0 &&
        !string.IsNullOrWhiteSpace(_emailSubject) &&
        !string.IsNullOrWhiteSpace(_emailMarkdown);

    protected override void OnInitialized()
    {
        _busy = true;
        _error = null;
        _result = null;
    }

    private string? ValidateEmails(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "At least one email is required.";

        var emails = value
            .Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(e => e.Trim())
            .Where(e => !string.IsNullOrWhiteSpace(e))
            .ToList();

        foreach (var email in emails)
        {
            try { _ = new System.Net.Mail.MailAddress(email); }
            catch { return $"Invalid email: {email}"; }
        }

        return null;
    }

    private string? ValidateOptionalEmails(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        var emails = value
            .Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(e => e.Trim())
            .Where(e => !string.IsNullOrWhiteSpace(e))
            .ToList();

        foreach (var email in emails)
        {
            try { _ = new System.Net.Mail.MailAddress(email); }
            catch { return $"Invalid email: {email}"; }
        }

        return null;
    }

    private void RefreshPreview()
    {
        _emailPreviewHtml = RenderEmailBodyHtml(_emailMarkdown ?? "");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_loadedOnce)
        {
            _loadedOnce = true;
            await LoadAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        _result = null;

        _emailSendError = null;
        _emailSendSuccess = null;
        _draftSaveError = null;
        _draftSaveSuccess = null;
        _draftWebLink = null;

        try
        {
            var userId = await ChatService.GetMyUserIdAsync();
            if (string.IsNullOrWhiteSpace(userId))
            {
                _error = "User not authenticated.";
                return;
            }

            if (ConversationId == Guid.Empty)
            {
                _error = "ConversationId is empty (Guid.Empty). The header must pass a real conversation id.";
                return;
            }

            _signatureName = await GetUserDisplayNameAsync(userId);

            ImproveConversationResultDto dto = await ImproveService.ImproveAsync(
                userId, ConversationId, options: null, CancellationToken.None);

            _result = dto;

            _emailSubject = FirstString(dto,
                "EmailSubject", "Subject", "DraftSubject", "SuggestedEmailSubject", "MailSubject")
                ?? "Conversation Summary";

            var md = FirstString(dto,
                "EmailBodyMarkdown", "BodyMarkdown", "DraftBodyMarkdown", "SuggestedEmailBodyMarkdown", "MailBodyMarkdown")
                ?? BuildFallbackEmailMarkdown(dto, _signatureName);

            _emailMarkdown = ApplySignature(md, _signatureName);

            // ✅ Always include the latest assistant answer as an appendix (Excel agent output lives here).
            // This fixes cases where the Improve service returns a generic fallback, or when ChatMessage.Text is empty.
            var latestAssistantMd = ExtractLatestAssistantMarkdown(ChatService.Messages);
            if (!string.IsNullOrWhiteSpace(latestAssistantMd))
            {
                // Avoid duplicating if already present (cheap check)
                if (!_emailMarkdown.Contains(latestAssistantMd, StringComparison.Ordinal))
                {
                    _emailMarkdown = _emailMarkdown.TrimEnd()
                                    + "\n\n---\n\n### Latest analysis\n\n"
                                    + latestAssistantMd.Trim()
                                    + "\n";
                }
            }

            // SQL tool appendices
            var sqlTablesAll = ExtractSqlResultMarkdownFromMessages(ChatService.Messages);
            var sqlTables = FilterSqlTablesAgainstLatest(sqlTablesAll, latestAssistantMd);
            var appendix = BuildSqlResultsAppendixMarkdown(sqlTables);

            if (!string.IsNullOrWhiteSpace(appendix) &&
                !_emailMarkdown.Contains("### Results", StringComparison.OrdinalIgnoreCase) &&
                !_emailMarkdown.Contains("## Results", StringComparison.OrdinalIgnoreCase))
            {
                _emailMarkdown = _emailMarkdown.TrimEnd() + "\n\n" + appendix.Trim() + "\n";
            }

            // Chart tool appendices
            var chartUrls = ExtractChartUrlsFromMessages(ChatService.Messages);

            // Avoid duplicating charts already present in the "latest analysis" markdown/html (e.g. Excel/SQL agent output
            // that already includes image links).
            var alreadyIncludedImgUrls = ExtractImageUrlsFromMarkdownOrHtml(_emailMarkdown);

            if (alreadyIncludedImgUrls.Count > 0)
            {
                chartUrls = chartUrls
                    .Where(u => !alreadyIncludedImgUrls.Contains(u))
                    .ToList();
            }

            var chartAppendix = BuildChartsAppendixMarkdown(chartUrls);
            if (!string.IsNullOrWhiteSpace(chartAppendix) &&
                !_emailMarkdown.Contains("### Charts", StringComparison.OrdinalIgnoreCase) &&
                !_emailMarkdown.Contains("## Charts", StringComparison.OrdinalIgnoreCase))
            {
                _emailMarkdown = _emailMarkdown.TrimEnd() + "\n\n" + chartAppendix.Trim() + "\n";
            }

            RefreshPreview();
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
        finally
        {
            _busy = false;
        }
    }

    // -------------------------
    // ChatMessage text extraction (IMPORTANT)
    // -------------------------
    private static string GetMessageText(Microsoft.Extensions.AI.ChatMessage m)
        => m is null ? "" : string.Concat(m.Contents.OfType<TextContent>().Select(t => t.Text));

    private static string ExtractLatestAssistantMarkdown(IEnumerable<Microsoft.Extensions.AI.ChatMessage> messages)
    {
        // Find last assistant message with any text content (not tool payload).
        var last = messages
            .Reverse()
            .FirstOrDefault(m => m is not null && m.Role == ChatRole.Assistant && !string.IsNullOrWhiteSpace(GetMessageText(m)));

        if (last is null) return "";

        var text = GetMessageText(last);
        if (string.IsNullOrWhiteSpace(text)) return "";

        // Strip hidden tool blobs but keep normal markdown/images.
        text = ToolMarkerRegex.Replace(text, "").Trim();
        return text;
    }

    // -------------------------
    // Hidden tool payload extractors
    // -------------------------
    private static bool TryReadToolMatch(Match match, out string type, out string b64)
    {
        type = "";
        b64 = "";

        if (match.Groups["type"].Success && match.Groups["b64"].Success)
        {
            type = match.Groups["type"].Value;
            b64 = match.Groups["b64"].Value;
            return true;
        }

        if (match.Groups["type2"].Success && match.Groups["b642"].Success)
        {
            type = match.Groups["type2"].Value;
            b64 = match.Groups["b642"].Value;
            return true;
        }

        return false;
    }

    private static List<string> ExtractSqlResultMarkdownFromMessages(IEnumerable<Microsoft.Extensions.AI.ChatMessage> messages)
    {
        var outTables = new List<string>();

        foreach (var m in messages)
        {
            var text = GetMessageText(m);
            if (string.IsNullOrWhiteSpace(text)) continue;

            foreach (Match match in ToolMarkerRegex.Matches(text))
            {
                if (!TryReadToolMatch(match, out var type, out var b64))
                    continue;

                if (!string.Equals(type, "sql_result", StringComparison.OrdinalIgnoreCase))
                    continue;

                string json;
                try { json = Encoding.UTF8.GetString(Convert.FromBase64String(b64)); }
                catch { continue; }

                try
                {
                    using var doc = JsonDocument.Parse(json);
                    var root = doc.RootElement;

                    if (root.ValueKind == JsonValueKind.Object &&
                        root.TryGetProperty("type", out var tEl) &&
                        tEl.ValueKind == JsonValueKind.String &&
                        string.Equals(tEl.GetString(), "markdown_table", StringComparison.OrdinalIgnoreCase) &&
                        root.TryGetProperty("markdown", out var mdEl) &&
                        mdEl.ValueKind == JsonValueKind.String)
                    {
                        var md = mdEl.GetString();
                        if (!string.IsNullOrWhiteSpace(md))
                            outTables.Add(md!.Trim());
                    }
                }
                catch { }
            }
        }

        return outTables;
    }

    private static List<string> ExtractChartUrlsFromMessages(IEnumerable<Microsoft.Extensions.AI.ChatMessage> messages)
    {
        var urls = new List<string>();

        foreach (var m in messages)
        {
            var text = GetMessageText(m);
            if (string.IsNullOrWhiteSpace(text)) continue;

            foreach (Match match in ToolMarkerRegex.Matches(text))
            {
                if (!TryReadToolMatch(match, out var type, out var b64))
                    continue;

                if (!string.Equals(type, "chart_result", StringComparison.OrdinalIgnoreCase))
                    continue;

                string json;
                try { json = Encoding.UTF8.GetString(Convert.FromBase64String(b64)); }
                catch { continue; }

                try
                {
                    using var doc = JsonDocument.Parse(json);
                    var root = doc.RootElement;

                    if (root.ValueKind == JsonValueKind.Object &&
                        root.TryGetProperty("url", out var urlEl) &&
                        urlEl.ValueKind == JsonValueKind.String)
                    {
                        var url = urlEl.GetString();
                        if (!string.IsNullOrWhiteSpace(url))
                            urls.Add(url!.Trim());
                    }
                }
                catch { }
            }
        }

        return urls;
    }

    private static string BuildSqlResultsAppendixMarkdown(IEnumerable<string> tables)
    {
        var list = tables?.Where(t => !string.IsNullOrWhiteSpace(t)).ToList() ?? new List<string>();

        // Deduplicate identical tables (same markdown) to avoid repeated results
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        list = list
            .Select(NormalizeMarkdownTable)
            .Where(t => !string.IsNullOrWhiteSpace(t) && seen.Add(t))
            .ToList();
        if (list.Count == 0) return "";

        var sb = new StringBuilder();
        sb.AppendLine();
        sb.AppendLine("### Results");
        sb.AppendLine();

        int i = 1;
        foreach (var t in list)
        {
            sb.AppendLine($"#### Result {i++}");
            sb.AppendLine();
            sb.AppendLine(NormalizeMarkdownTable(t));
            sb.AppendLine();
        }

        return sb.ToString();
    }

    private static string BuildChartsAppendixMarkdown(IEnumerable<string> urls)
    {
        var list = urls?.Where(u => !string.IsNullOrWhiteSpace(u)).Distinct(StringComparer.OrdinalIgnoreCase).ToList()
                   ?? new List<string>();
        if (list.Count == 0) return "";

        var sb = new StringBuilder();
        sb.AppendLine();
        sb.AppendLine("### Charts");
        sb.AppendLine();

        int i = 1;
        foreach (var url in list)
        {
            sb.AppendLine($"#### Chart {i++}");
            sb.AppendLine();
            sb.AppendLine($"![chart]({url})");
            sb.AppendLine();
        }

        return sb.ToString();
    }


    private static List<string> FilterSqlTablesAgainstLatest(IEnumerable<string> tables, string? latestAssistantMarkdown)
    {
        var list = tables?.Where(t => !string.IsNullOrWhiteSpace(t)).ToList() ?? new List<string>();
        if (list.Count == 0) return list;

        if (string.IsNullOrWhiteSpace(latestAssistantMarkdown))
            return list;

        var latestNorm = NormalizeMarkdownTable(latestAssistantMarkdown);

        // If the latest assistant message already contains the same markdown table(s),
        // don't re-append them under "Results" to avoid duplicates.
        var filtered = new List<string>();
        foreach (var t in list)
        {
            var tn = NormalizeMarkdownTable(t);

            if (!string.IsNullOrWhiteSpace(latestNorm) &&
                (latestNorm.Contains(tn, StringComparison.OrdinalIgnoreCase) ||
                 tn.Contains(latestNorm, StringComparison.OrdinalIgnoreCase)))
            {
                continue;
            }

            filtered.Add(t);
        }

        return filtered;
    }

    private static string NormalizeMarkdownTable(string md)
    {
        if (string.IsNullOrWhiteSpace(md)) return md;

        var t = md.Trim().Replace("\\r\\n", "\n").Replace("\\n", "\n").Replace("\r\n", "\n");
        return t;
    }

    private static HashSet<string> ExtractImageUrlsFromMarkdownOrHtml(string? markdownOrHtml)
    {
        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(markdownOrHtml)) return set;

        var s = markdownOrHtml;

        // Markdown images: ![alt](url)
        foreach (Match m in Regex.Matches(s, @"!\[[^\]]*\]\((?<url>[^)\s]+)\)", RegexOptions.IgnoreCase))
        {
            var url = m.Groups["url"].Value?.Trim();
            if (!string.IsNullOrWhiteSpace(url)) set.Add(url);
        }

        // HTML images: <img src="url">
        foreach (Match m in Regex.Matches(s, @"<img\b[^>]*?\bsrc\s*=\s*""(?<url>[^""]+)""[^>]*>", RegexOptions.IgnoreCase))
        {
            var url = m.Groups["url"].Value?.Trim();
            if (!string.IsNullOrWhiteSpace(url)) set.Add(url);
        }

        return set;
    }

    private static string? FirstString(object obj, params string[] candidates)
    {
        foreach (var name in candidates)
        {
            var p = obj.GetType().GetProperty(name, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
            if (p is null) continue;
            var v = p.GetValue(obj);
            if (v is string s && !string.IsNullOrWhiteSpace(s))
                return s;
        }
        return null;
    }

    // -------------------------
    // Email Send/Draft
    // -------------------------

    private async Task SaveDraftAsync()
    {
        _draftSaveError = null;
        _draftSaveSuccess = null;
        _draftWebLink = null;

        _emailSendError = null;
        _emailSendSuccess = null;

        var to = SplitEmails(_emailTo);
        var cc = SplitEmails(_emailCc);

        if (to.Length == 0) { _draftSaveError = "Please enter at least one recipient."; return; }
        if (string.IsNullOrWhiteSpace(_emailSubject)) { _draftSaveError = "Please enter a subject."; return; }
        if (string.IsNullOrWhiteSpace(_emailMarkdown)) { _draftSaveError = "Email body is empty."; return; }

        _sendingEmail = true;

        try
        {
            _emailMarkdown = ApplySignature(_emailMarkdown ?? "", _signatureName);

            var render = await RenderEmailHtmlForSendingWithInlineAsync(_emailMarkdown ?? "", CancellationToken.None);

            var draft = await EmailService.CreateDraftAsync(
                to,
                _emailSubject ?? "",
                render.Html,
                cc.Length > 0 ? cc : null,
                render.InlineAttachments,
                CancellationToken.None);

            _draftSaveSuccess = "Draft saved to Outlook (Drafts).";
            _draftWebLink = draft?.WebLink;
        }
        catch (Exception ex)
        {
            _draftSaveError = ex.ToString();
        }
        finally
        {
            _sendingEmail = false;
        }
    }

    private async Task SendEmailAsync()
    {
        _emailSendError = null;
        _emailSendSuccess = null;

        _draftSaveError = null;
        _draftSaveSuccess = null;
        _draftWebLink = null;

        var to = SplitEmails(_emailTo);
        var cc = SplitEmails(_emailCc);

        if (to.Length == 0) { _emailSendError = "Please enter at least one recipient."; return; }

        _sendingEmail = true;

        try
        {
            _emailMarkdown = ApplySignature(_emailMarkdown ?? "", _signatureName);

            var render = await RenderEmailHtmlForSendingWithInlineAsync(_emailMarkdown ?? "", CancellationToken.None);

            await EmailService.SendAsync(
                to,
                _emailSubject ?? "",
                render.Html,
                cc.Length > 0 ? cc : null,
                saveToSentItems: true,
                attachments: render.InlineAttachments,
                ct: CancellationToken.None);

            _emailSendSuccess = "Email sent successfully.";
        }
        catch (Exception ex)
        {
            _emailSendError = ex.ToString();
        }
        finally
        {
            _sendingEmail = false;
        }
    }

    private static string[] SplitEmails(string? input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return Array.Empty<string>();

        return input
            .Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private static string ApplySignature(string markdown, string? signatureName)
    {
        var name = string.IsNullOrWhiteSpace(signatureName) ? null : signatureName.Trim();
        if (string.IsNullOrWhiteSpace(markdown))
            return markdown;

        var m = markdown;

        if (!string.IsNullOrWhiteSpace(name))
        {
            m = m.Replace("[Your Name]", name, StringComparison.OrdinalIgnoreCase);
            m = m.Replace("{Your Name}", name, StringComparison.OrdinalIgnoreCase);
        }

        if (!string.IsNullOrWhiteSpace(name))
        {
            var trimmed = m.TrimEnd();
            if (!trimmed.Contains("\nBest,", StringComparison.OrdinalIgnoreCase) &&
                !trimmed.Contains("\nRegards,", StringComparison.OrdinalIgnoreCase))
            {
                m = trimmed + "\n\nBest,\n" + name + "\n";
            }
        }

        return m;
    }

    private static readonly global::Markdig.MarkdownPipeline _mdPipeline =
        new global::Markdig.MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();

    private static string RenderEmailBodyHtml(string markdown)
        => global::Markdig.Markdown.ToHtml(markdown ?? "", _mdPipeline);

    private sealed record RenderedEmail(string Html, List<EmailAttachment> InlineAttachments);

    private async Task<RenderedEmail> RenderEmailHtmlForSendingWithInlineAsync(string markdown, CancellationToken ct)
    {
        var bodyHtml = RenderEmailBodyHtml(markdown ?? "");

        bodyHtml = InlineTableStylesOutlookSafe(bodyHtml);

        var (htmlWithCid, inlineAttachments) = await ConvertImagesToCidInlineAsync(bodyHtml, ct);

        var wrapped = $@"
<div style=""font-family: Arial, sans-serif; font-size: 14px; line-height: 1.45; color:#111;"">
{htmlWithCid}
</div>";

        return new RenderedEmail(wrapped, inlineAttachments);
    }

    private static string InlineTableStylesOutlookSafe(string html)
    {
        if (string.IsNullOrWhiteSpace(html)) return html ?? "";

        const string tableStyle =
            "border-collapse:collapse;border-spacing:0;margin:0px 0 0px 0;" +
            "mso-table-lspace:0pt;mso-table-rspace:0pt;" +
            "border:1px solid #d0d0d0;";

        const string thStyle =
            "border:1px solid #d0d0d0;padding:3px 6px;font-size:12px;line-height:1.2;" +
            "text-align:left;font-weight:600;background-color:#f5f5f5;" +
            "mso-line-height-rule:exactly;";

        const string tdStyle =
            "border:1px solid #d0d0d0;padding:3px 6px;font-size:12px;line-height:1.2;" +
            "text-align:left;mso-line-height-rule:exactly;";

        html = Regex.Replace(html, "<table([^>]*)>", m =>
        {
            var tag = m.Value;

            if (Regex.IsMatch(tag, "\\bstyle\\s*=", RegexOptions.IgnoreCase))
            {
                tag = Regex.Replace(tag, "\\bstyle\\s*=\\s*\"([^\"]*)\"", mm =>
                {
                    var existing = mm.Groups[1].Value ?? "";
                    if (existing.Contains("mso-table-lspace", StringComparison.OrdinalIgnoreCase))
                        return mm.Value;

                    return $"style=\"{existing.TrimEnd(';')};{tableStyle}\"";
                }, RegexOptions.IgnoreCase);
            }
            else
            {
                tag = tag.Insert(tag.Length - 1, $" style=\"{tableStyle}\"");
            }

            if (!Regex.IsMatch(tag, "\\bcellpadding\\s*=", RegexOptions.IgnoreCase))
                tag = tag.Replace("<table", "<table cellpadding=\"0\"", StringComparison.OrdinalIgnoreCase);
            if (!Regex.IsMatch(tag, "\\bcellspacing\\s*=", RegexOptions.IgnoreCase))
                tag = tag.Replace("<table", "<table cellspacing=\"0\"", StringComparison.OrdinalIgnoreCase);

            if (!Regex.IsMatch(tag, "\\bborder\\s*=", RegexOptions.IgnoreCase))
                tag = tag.Replace("<table", "<table border=\"1\"", StringComparison.OrdinalIgnoreCase);
            if (!Regex.IsMatch(tag, "\\bbordercolor\\s*=", RegexOptions.IgnoreCase))
                tag = tag.Replace("<table", "<table bordercolor=\"#d0d0d0\"", StringComparison.OrdinalIgnoreCase);

            return tag;
        }, RegexOptions.IgnoreCase);

        html = Regex.Replace(html, "<th([^>]*)>", m =>
        {
            var tag = m.Value;

            if (Regex.IsMatch(tag, "\\bstyle\\s*=", RegexOptions.IgnoreCase))
            {
                tag = Regex.Replace(tag, "\\bstyle\\s*=\\s*\"([^\"]*)\"", mm =>
                {
                    var existing = mm.Groups[1].Value ?? "";
                    if (existing.Contains("border:", StringComparison.OrdinalIgnoreCase))
                        return mm.Value;

                    return $"style=\"{existing.TrimEnd(';')};border:1px solid #d0d0d0;\"";
                }, RegexOptions.IgnoreCase);

                if (!Regex.IsMatch(tag, "\\bbgcolor\\s*=", RegexOptions.IgnoreCase))
                    tag = tag.Insert(tag.Length - 1, " bgcolor=\"#f5f5f5\"");

                return tag;
            }

            return tag.Insert(tag.Length - 1, $" style=\"{thStyle}\" bgcolor=\"#f5f5f5\"");
        }, RegexOptions.IgnoreCase);

        html = Regex.Replace(html, "<td([^>]*)>", m =>
        {
            var tag = m.Value;

            if (Regex.IsMatch(tag, "\\bstyle\\s*=", RegexOptions.IgnoreCase))
            {
                tag = Regex.Replace(tag, "\\bstyle\\s*=\\s*\"([^\"]*)\"", mm =>
                {
                    var existing = mm.Groups[1].Value ?? "";
                    if (existing.Contains("border:", StringComparison.OrdinalIgnoreCase))
                        return mm.Value;

                    return $"style=\"{existing.TrimEnd(';')};border:1px solid #d0d0d0;\"";
                }, RegexOptions.IgnoreCase);

                return tag;
            }

            return tag.Insert(tag.Length - 1, $" style=\"{tdStyle}\"");
        }, RegexOptions.IgnoreCase);

        return html;
    }

    private async Task<(string Html, List<EmailAttachment> InlineAttachments)> ConvertImagesToCidInlineAsync(string html, CancellationToken ct)
    {
        var imgRegex = new Regex(
            "<img\\b(?<pre>[^>]*?)\\bsrc\\s*=\\s*\"(?<src>[^\"]+)\"(?<post>[^>]*)>",
            RegexOptions.IgnoreCase | RegexOptions.Compiled);

        var urls = new List<string>();

        foreach (Match m in imgRegex.Matches(html))
        {
            var src = m.Groups["src"].Value?.Trim();
            if (string.IsNullOrWhiteSpace(src)) continue;

            if (src.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ||
                src.StartsWith("cid:", StringComparison.OrdinalIgnoreCase))
                continue;

            var fetchUrl = src;

            if (src.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                src.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            {
                // ok
            }
            else
            {
                try
                {
                    fetchUrl = new Uri(new Uri(Nav.BaseUri), src).ToString();
                }
                catch
                {
                    continue;
                }
            }

            urls.Add(src + "|FETCH|" + fetchUrl);
        }

        if (urls.Count == 0)
            return (html, new List<EmailAttachment>());

        using var http = HttpClientFactory.CreateClient();
        http.Timeout = TimeSpan.FromSeconds(12);

        var cookieHeader = HttpContextAccessor.HttpContext?.Request?.Headers["Cookie"].ToString();
        if (!string.IsNullOrWhiteSpace(cookieHeader))
        {
            http.DefaultRequestHeaders.Remove("Cookie");
            http.DefaultRequestHeaders.Add("Cookie", cookieHeader);
        }

        var inline = new List<EmailAttachment>();
        var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        int idx = 1;
        foreach (var entry in urls.Distinct(StringComparer.OrdinalIgnoreCase))
        {
            var parts = entry.Split("|FETCH|", 2, StringSplitOptions.None);
            var originalSrc = parts[0];
            var fetchUrl = parts.Length > 1 ? parts[1] : parts[0];
            try
            {
                using var resp = await http.GetAsync(fetchUrl, ct);
                if (!resp.IsSuccessStatusCode) continue;

                var bytes = await resp.Content.ReadAsByteArrayAsync(ct);
                if (bytes is null || bytes.Length == 0) continue;

                if (bytes.Length > 4_000_000) continue;

                var contentType = resp.Content.Headers.ContentType?.MediaType?.ToLowerInvariant();
                if (string.IsNullOrWhiteSpace(contentType))
                {
                    if (fetchUrl.EndsWith(".png", StringComparison.OrdinalIgnoreCase)) contentType = "image/png";
                    else if (fetchUrl.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || fetchUrl.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase)) contentType = "image/jpeg";
                    else if (fetchUrl.EndsWith(".gif", StringComparison.OrdinalIgnoreCase)) contentType = "image/gif";
                    else contentType = "image/png";
                }

                var ext = contentType switch
                {
                    "image/jpeg" => "jpg",
                    "image/gif" => "gif",
                    _ => "png"
                };

                var cid = $"img{idx}@inline";
                var fileName = $"inline-{idx}.{ext}";
                idx++;

                inline.Add(new EmailAttachment(
                    FileName: fileName,
                    ContentType: contentType!,
                    ContentBytes: bytes,
                    IsInline: true,
                    ContentId: cid));

                map[originalSrc] = $"cid:{cid}";
            }
            catch
            {
                // ignore
            }
        }

        if (map.Count == 0)
            return (html, inline);

        var replaced = imgRegex.Replace(html, m =>
        {
            var src = m.Groups["src"].Value;
            if (map.TryGetValue(src, out var cidSrc))
                return $"<img{m.Groups["pre"].Value}src=\"{cidSrc}\"{m.Groups["post"].Value}>";

            return m.Value;
        });

        return (replaced, inline);
    }

