    protected override void OnInitialized()
    {
        ChatService.OnMessagesUpdated += HandleChatUpdated;
    }

    private void HandleChatUpdated()
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
        => ChatService.OnMessagesUpdated -= HandleChatUpdated;

