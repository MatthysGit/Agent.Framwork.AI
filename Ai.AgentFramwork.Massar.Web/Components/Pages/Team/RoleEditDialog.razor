@using Ai.AgentFramwork.Massar.Web.Services.Teams
@inject ITeamAdminService TeamService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="_name"
                          Label="Role name"
                          Variant="Variant.Outlined"
                          Dense="true"
                          Required="true"/>

            <MudSwitch T="bool" Dense="true" @bind-Value="_isActive" Color="Color.Success">
                Active
            </MudSwitch>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="OnCancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="OnSaveAsync">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int? RoleId { get; set; }

    private bool _saving;
    private bool _isEdit => RoleId.HasValue;

    private string _name = string.Empty;
    private bool _isActive = true;

    protected override async Task OnInitializedAsync()
    {
        if (!_isEdit) return;

        var role = await TeamService.GetRoleAsync(RoleId!.Value);
        if (role is null)
        {
            Snackbar.Add("Role not found.", Severity.Error);
            MudDialog.Cancel();
            return;
        }

        _name = role.Name ?? string.Empty;
        _isActive = role.IsActive;
    }

    private void OnCancel()
    {
        MudDialog.Cancel();
    }

    private async Task OnSaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("Role name is required.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            if (!_isEdit)
                await TeamService.CreateRoleAsync(_name.Trim(), _isActive);
            else
                await TeamService.UpdateRoleAsync(RoleId!.Value, _name.Trim(), _isActive);

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.GetBaseException().Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

}