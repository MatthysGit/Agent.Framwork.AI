@page "/security/users"
@using Ai.AgentFramwork.Massar.Web.DBModels
@using Ai.AgentFramwork.Massar.Web.Services.Security
@using Microsoft.EntityFrameworkCore

@* CHANGED: use DbContextFactory to avoid concurrent-DbContext operations *@
@inject IDbContextFactory<AppDbContext> DbFactory

@inject IDialogService Dialog
@inject ISnackbar Snackbar
@inject IPasswordService _Passwords;

<MudPaper Class="pa-2" Elevation="1" Rounded="true">
    <MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
        <MudGrid Spacing="3">
            <!-- LEFT -->
            <MudItem xs="12">
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.subtitle2">Users</MudText>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddUser">
                        Add
                    </MudButton>
                </MudStack>

                <MudDivider Class="my-3" />

                <MudTextField @bind-Value="_userSearch"
                              Placeholder="Search users..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Dense="true"
                              Typo="Typo.caption"
                              Immediate="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="mb-2" />

                <MudDataGrid T="AppUser"
                             Items="FilteredUsers"
                             Dense="true"
                             Hover="true"
                             Bordered="true"
                             FixedHeader="true"
                             Height="420px"
                             Class="users-dg"
                             RowClick="OnUserRowClick"
                             RowClassFunc="UserRowClass">
                    <Columns>
                        
                        <PropertyColumn T="AppUser" TProperty="string"
                                        Typo="Typo.caption"
                                        Property="x => x.FirstName"
                                        Title="Name" />
                        
                        <PropertyColumn T="AppUser" TProperty="string"
                                        Typo="Typo.caption"
                                        Property="x => x.LastName"
                                        Title="Surname" />


                        <PropertyColumn T="AppUser" TProperty="string"
                                        Typo="Typo.caption"
                                        Property="x => x.UserName"
                                        Title="UserName" />

                        <PropertyColumn T="AppUser" TProperty="string"
                                        Typo="Typo.caption"
                                        Property="x => x.Email"
                                        Title="Email" />

                        <TemplateColumn T="AppUser" Title="Role" Sortable="false" Filterable="false">
                            <CellTemplate Context="ctx">
                                <MudText Typo="Typo.caption">@RoleName(ctx.Item)</MudText>
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn T="AppUser" Title="Monthly AI Limit" Sortable="false" Filterable="false">
                            <CellTemplate Context="ctx">
                                <MudText Typo="Typo.caption">@FormatMonthlyAiLimit(ctx.Item)</MudText>
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn T="AppUser"
                                        Title=""
                                        Sortable="false"
                                        Filterable="false"
                                        CellClass="users-dg-actions"
                                        HeaderClass="users-dg-actions">
                            <CellTemplate Context="ctx">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Class="ma-0"
                                               OnClick="@(() => EditUser(ctx.Item.UserId))" />
                            </CellTemplate>
                        </TemplateColumn>

                    </Columns>
                </MudDataGrid>

            </MudItem>

            <!-- RIGHT -->
            @*   <MudItem xs="12" md="7">

                <MudText Typo="Typo.subtitle2">User Roles</MudText>
                <MudDivider Class="my-3" />

                @if (_selectedUser is null)
                {
                    <MudText Color="Color.Secondary">Select a user.</MudText>
                }
                else
                {
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Color="Color.Surface">User: @_selectedUser.FirstName @_selectedUser.LastName</MudText>
                    </MudStack>

                    <MudGrid Spacing="2" Class="mt-3">
                        <MudItem xs="12">
                            <MudPaper Outlined="true" Class="pa-2" Style="height: 435px; overflow:auto;">
                                <MudText Typo="Typo.caption" Color="Color.Surface" Class="mb-1">
                                    Tick Roles
                                </MudText>

                                @foreach (var team in _allTeams)
                                {
                                    var teamId = team.TeamId;

                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                                        <MudCheckBox T="bool"
