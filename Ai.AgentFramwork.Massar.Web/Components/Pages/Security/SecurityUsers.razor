            </MudItem> *@
        </MudGrid>
    </MudContainer>
</MudPaper>

<style>
    /* MudDataGrid tweaks */
    .users-dg {
        border-radius: 8px;
        overflow: hidden;
    }

    .users-dg-actions {
        text-align: right;
        justify-content: flex-end;
        white-space: nowrap;
        width: 1%;
    }

    /* Selected row look */
    .users-dg-selected > td {
        background-color: var(--purple) !important;
    }
</style>

@code {
    private List<AppUser> _users = new();

    private List<Team> _allTeams = new();
    private List<TeamRole> _allTeamRoles = new();
    private Dictionary<int, List<TeamRole>> _teamRolesByTeamId = new();

    private AppUser? _selectedUser;

    // For fast lookup of assigned roles
    private HashSet<int> _selectedRoleIds = new();

    // Search
    private string _userSearch = string.Empty;

    // CHANGED: cancel in-flight work if component is disposed (helps with circuit disconnects)
    private CancellationTokenSource _cts = new();
    private bool _disposed;

    private List<AppUser> FilteredUsers
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_userSearch))
                return _users;

            var s = _userSearch.Trim();
            return _users
                .Where(x =>
                    (!string.IsNullOrWhiteSpace(x.UserName) && x.UserName.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrWhiteSpace(x.Email) && x.Email.Contains(s, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
    }

    private bool IsSelected(string userId)
        => _selectedUser?.UserId == userId;

    // row class function for MudDataGrid
    private string UserRowClass(AppUser user, int rowNumber)
        => IsSelected(user.UserId) ? "users-dg-selected" : string.Empty;

    // row click handler for MudDataGrid
    private async Task OnUserRowClick(DataGridRowClickEventArgs<AppUser> args)
    {
        if (args.Item is null) return;
        await ManageRoles(args.Item.UserId);
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _users = await db.AppUsers
            .AsNoTracking()
            .Include(x => x.Role)
            .Include(x => x.AiUserMonthlyCostLimit)
            .OrderBy(x => x.UserName)
            .ToListAsync(_cts.Token);

        _allTeams = await db.Teams
            .AsNoTracking()
            .OrderBy(x => x.Name)
            .ToListAsync(_cts.Token);

        // IMPORTANT: include Team + Role so labels make sense
        _allTeamRoles = await db.TeamRoles
            .AsNoTracking()
            .Include(x => x.Team)
            .Include(x => x.Role)
            .OrderBy(x => x.Team!.Name)
            .ThenBy(x => x.Role!.Name)
            .ToListAsync(_cts.Token);

        _teamRolesByTeamId = _allTeamRoles
            .GroupBy(x => x.TeamId)
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private async Task ReloadUsers()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _users = await db.AppUsers
            .AsNoTracking()
            .Include(x => x.Role)
            .Include(x => x.AiUserMonthlyCostLimit)
            .OrderBy(x => x.UserName)
            .ToListAsync(_cts.Token);
    }

    private static string RoleName(AppUser u)
        => u.Role?.Name ?? (u.RoleId is null ? "" : $"RoleId {u.RoleId}");

    private static string RoleName(TeamRole tr)
    {
        return tr.Role?.Name ?? $"RoleId {tr.RoleId}";
    }

    // CHANGED: helper now takes a db instance (no shared DbContext across awaits)
    private static async Task SyncUserSecurityGroups(AppDbContext db, string userId, IReadOnlyCollection<int>? desiredSecurityGroupIds, CancellationToken ct)
    {
        var desired = (desiredSecurityGroupIds ?? Array.Empty<int>())
            .Distinct()
            .ToHashSet();

        var existing = await db.UserSecurityGroups
            .Where(x => x.UserId == userId)
            .ToListAsync(ct);

        // Remove unselected
        var toRemove = existing.Where(x => !desired.Contains(x.SecurityGroupId)).ToList();
        if (toRemove.Count > 0)
            db.UserSecurityGroups.RemoveRange(toRemove);

        // Add new
        var existingIds = existing.Select(x => x.SecurityGroupId).ToHashSet();
        var toAdd = desired
            .Where(id => !existingIds.Contains(id))
            .Select(id => new UserSecurityGroup
            {
                UserId = userId,
                SecurityGroupId = id
            })
            .ToList();

        if (toAdd.Count > 0)
            await db.UserSecurityGroups.AddRangeAsync(toAdd, ct);
    }


    private static string FormatMonthlyAiLimit(AppUser user)
    {
        var value = user.AiUserMonthlyCostLimit?.MonthlyLimitUsd;
        return value.HasValue ? $"${value.Value:0.##}" : "-";
    }

    private static async Task UpsertMonthlyAiCostLimitAsync(AppDbContext db, string userId, decimal monthlyLimitUsd, CancellationToken ct)
    {
        var existing = await db.AiUserMonthlyCostLimits.FirstOrDefaultAsync(x => x.UserId == userId, ct);
        if (existing is null)
        {
            db.AiUserMonthlyCostLimits.Add(new AiUserMonthlyCostLimit
            {
                UserId = userId,
                MonthlyLimitUsd = monthlyLimitUsd,
                IsActive = true,
                CreatedOn = DateTime.UtcNow,
                UpdatedOn = DateTime.UtcNow
            });
            return;
        }

        existing.MonthlyLimitUsd = monthlyLimitUsd;
        existing.IsActive = true;
        existing.UpdatedOn = DateTime.UtcNow;
    }

    private async Task EditUser(string userId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var user = await db.AppUsers
            .AsNoTracking()
            .Include(x => x.AiUserMonthlyCostLimit)
            .FirstOrDefaultAsync(x => x.UserId == userId, _cts.Token);
        if (user is null) return;

        var parameters = new DialogParameters
        {
            ["EditUserId"] = user.UserId,
            ["EditUserName"] = user.UserName,
            ["EditEmail"] = user.Email,
            ["EditFirstName"] = user.FirstName,
            ["EditLastName"] = user.LastName,
            ["EditIsActive"] = user.IsActive,
            ["EditRoleId"] = user.RoleId,
            ["EditMonthlyAiCostLimitUsd"] = user.AiUserMonthlyCostLimit?.MonthlyLimitUsd
        };

        var dialog = await Dialog.ShowAsync<AddUserDialog>(
            "Edit User",
            parameters,
            new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Small });

        var result = await dialog.Result;
        if (result?.Canceled != false) return;

        var dto = (AddUserDialog.UserUpsertDto)result.Data;

        var newUserName = dto.UserName.Trim();
        var newEmail = dto.Email.Trim();

        var exists = await db.AppUsers.AnyAsync(x =>
            x.UserId != userId &&
            (x.UserName == newUserName || x.Email == newEmail), _cts.Token);

        if (exists)
        {
            Snackbar.Add("UserName or Email already exists.", Severity.Error);
            return;
        }

        var tracked = await db.AppUsers.FirstOrDefaultAsync(x => x.UserId == userId, _cts.Token);
        if (tracked is null) return;

        tracked.UserName = newUserName;
        tracked.Email = newEmail;
        tracked.FirstName = dto.FirstName;
        tracked.LastName = dto.LastName;
        tracked.IsActive = dto.IsActive;
        tracked.RoleId = dto.RoleId;

        await UpsertMonthlyAiCostLimitAsync(db, tracked.UserId, dto.MonthlyAiCostLimitUsd, _cts.Token);

        if (!string.IsNullOrWhiteSpace(dto.Password))
            tracked.PasswordHash = _Passwords.Hash(dto.Password);

        // ✅ persist SecurityGroup links
        await SyncUserSecurityGroups(db, userId, dto.SecurityGroupIds, _cts.Token);

        await db.SaveChangesAsync(_cts.Token);

        Snackbar.Add("User updated.", Severity.Success);

        await ReloadUsers();

        if (_selectedUser?.UserId == userId)
            await ManageRoles(userId);
    }

    private async Task AddUser()
    {
        var dialog = await Dialog.ShowAsync<AddUserDialog>(
            "Add User",
            new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Small });

        var result = await dialog.Result;
        if (result?.Canceled != false) return;

        var dto = (AddUserDialog.UserUpsertDto)result.Data;

        var userName = dto.UserName.Trim();
        var email = dto.Email.Trim();

        await using var db = await DbFactory.CreateDbContextAsync();

        var exists = await db.AppUsers.AnyAsync(x => x.UserName == userName || x.Email == email, _cts.Token);
        if (exists)
        {
            Snackbar.Add("UserName or Email already exists.", Severity.Error);
            return;
        }

        var user = new AppUser
        {
            UserId = Guid.NewGuid().ToString("N"),
            UserName = userName,
            Email = email,
            FirstName = dto.FirstName,
            LastName = dto.LastName,
            IsActive = dto.IsActive,
            CreatedAtUtc = DateTime.UtcNow,
            PasswordHash = _Passwords.Hash(dto.Password ?? string.Empty),
            RoleId = dto.RoleId
        };

        db.AppUsers.Add(user);
        await db.SaveChangesAsync(_cts.Token);

        await UpsertMonthlyAiCostLimitAsync(db, user.UserId, dto.MonthlyAiCostLimitUsd, _cts.Token);

        // ✅ persist SecurityGroup links for new user
        await SyncUserSecurityGroups(db, user.UserId, dto.SecurityGroupIds, _cts.Token);
        await db.SaveChangesAsync(_cts.Token);

        Snackbar.Add("User created.", Severity.Success);
        await ReloadUsers();
    }

    private async Task ManageRoles(string userId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _selectedUser = await db.AppUsers.AsNoTracking().FirstOrDefaultAsync(x => x.UserId == userId, _cts.Token);
        if (_selectedUser is null) return;

        var roleIds = await db.UserTeamRoles
            .AsNoTracking()
            .Where(x => x.UserId == userId)
            .Select(x => x.TeamRoleId)
            .ToListAsync(_cts.Token);

        _selectedRoleIds = roleIds.ToHashSet();
    }

    private bool IsRoleChecked(int teamRoleId) => _selectedRoleIds.Contains(teamRoleId);

    private bool IsTeamFullyChecked(int teamId)
    {
        var roles = _teamRolesByTeamId.GetValueOrDefault(teamId);
        if (roles is null || roles.Count == 0) return false;
        return roles.All(r => _selectedRoleIds.Contains(r.TeamRoleId));
    }

    private bool IsTeamIndeterminate(int teamId)
    {
        var roles = _teamRolesByTeamId.GetValueOrDefault(teamId);
        if (roles is null || roles.Count == 0) return false;

        var any = roles.Any(r => _selectedRoleIds.Contains(r.TeamRoleId));
        var all = roles.All(r => _selectedRoleIds.Contains(r.TeamRoleId));
        return any && !all;
    }

    private Task OnRoleCheckedChanged(int teamRoleId, bool isChecked) => ToggleRole(teamRoleId, isChecked);
    private Task OnTeamCheckedChanged(int teamId, bool isChecked) => ToggleTeam(teamId, isChecked);

    private async Task ToggleRole(int teamRoleId, bool isChecked)
    {
        if (_selectedUser is null) return;

        await using var db = await DbFactory.CreateDbContextAsync();

        if (isChecked)
        {
            if (_selectedRoleIds.Add(teamRoleId))
            {
                db.UserTeamRoles.Add(new UserTeamRole
                {
                    UserId = _selectedUser.UserId,
                    TeamRoleId = teamRoleId,
                    AddedAtUtc = DateTime.UtcNow
                });

                await db.SaveChangesAsync(_cts.Token);
            }
        }
        else
        {
            if (_selectedRoleIds.Remove(teamRoleId))
            {
                var row = await db.UserTeamRoles
                    .FirstOrDefaultAsync(x => x.UserId == _selectedUser.UserId && x.TeamRoleId == teamRoleId, _cts.Token);

                if (row is not null)
                {
                    db.UserTeamRoles.Remove(row);
                    await db.SaveChangesAsync(_cts.Token);
                }
            }
        }
    }

    private async Task ToggleTeam(int teamId, bool isChecked)
    {
        if (_selectedUser is null) return;

        var roles = _teamRolesByTeamId.GetValueOrDefault(teamId) ?? new List<TeamRole>();
        if (roles.Count == 0) return;

        await using var db = await DbFactory.CreateDbContextAsync();

        if (isChecked)
        {
            // Add all roles in that team
            var toAdd = roles.Where(r => !_selectedRoleIds.Contains(r.TeamRoleId)).ToList();
            if (toAdd.Count == 0) return;

            foreach (var r in toAdd)
            {
                _selectedRoleIds.Add(r.TeamRoleId);
                db.UserTeamRoles.Add(new UserTeamRole
                {
                    UserId = _selectedUser.UserId,
                    TeamRoleId = r.TeamRoleId,
                    AddedAtUtc = DateTime.UtcNow
                });
            }

            await db.SaveChangesAsync(_cts.Token);
        }
        else
        {
            // Remove all roles in that team
            var roleIds = roles.Select(r => r.TeamRoleId).ToList();
            foreach (var rid in roleIds)
                _selectedRoleIds.Remove(rid);

            var rows = await db.UserTeamRoles
                .Where(x => x.UserId == _selectedUser.UserId && roleIds.Contains(x.TeamRoleId))
                .ToListAsync(_cts.Token);

            if (rows.Count > 0)
            {
                db.UserTeamRoles.RemoveRange(rows);
                await db.SaveChangesAsync(_cts.Token);
            }
        }
    }

    private async Task RemoveUserRole(int teamRoleId)
    {
        // chip close = untick role
        await ToggleRole(teamRoleId, false);
    }

    public void Dispose()
    {
        _disposed = true;
        try { _cts.Cancel(); } catch { }
        _cts.Dispose();
    }
}