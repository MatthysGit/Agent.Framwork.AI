                                                     Checked="@IsTeamFullyChecked(teamId)"
                                                     Indeterminate="@IsTeamIndeterminate(teamId)"
                                                     CheckedChanged="@((bool v) => OnTeamCheckedChanged(teamId, v))" />
                                        <MudText Typo="Typo.caption">@team.Name</MudText>
                                    </MudStack>

                                    <MudStack Class="ml-6" Spacing="0">
                                        @foreach (var tr in _teamRolesByTeamId.GetValueOrDefault(teamId) ?? new List<TeamRole>())
                                        {
