@page "/security/permissions"

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6">Permissions</MudText>
        <MudText Color="Color.Surface">
            Assign access by <b>Team</b> or <b>Role (in a Team)</b> to control visibility of Document Sources, Documents, Tables, and Fields.
        </MudText>

        <MudDivider Class="my-3"/>

        <MudTabs>
            <MudTabPanel Text="Document Sources">
                <SecurityMatrixDocSources/>
            </MudTabPanel>

            <MudTabPanel Text="Documents">
                <SecurityMatrixDocuments/>
            </MudTabPanel>

            <MudTabPanel Text="Table Definitions">
                <SecurityMatrixTables/>
            </MudTabPanel>

@*             <MudTabPanel Text="Table Fields">
                <SecurityMatrixFields/>
            </MudTabPanel> *@
        </MudTabs>
    </MudPaper>
</MudContainer>