@page "/security/matrix/field-role-access"

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using Ai.AgentFramwork.Massar.Web.DBModels
@using Ai.AgentFramwork.Massar.Web.Models

@using AccessEntity = Ai.AgentFramwork.Massar.Web.DBModels.TableFieldDefinitionRoleAccess

@inject AppDbContext Db
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<MudGrid Spacing="3" Class="mt-3">

    <!-- LEFT: Role + List -->
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-3">

            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle2">Role</MudText>

                <MudAutocomplete T="Role"
                                 Dense="true"
                                 Clearable="true"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 CoerceValue="true"
                                 ToStringFunc="@(r => r?.Name ?? string.Empty)"
                                 SearchFunc="SearchRolesAsync"
                                 Value="_selectedRole"
                                 ValueChanged="@(EventCallback.Factory.Create<Role?>(this, OnRoleChangedAsync))"
                                 Placeholder="Search role..."
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.Search" />

                <MudDivider Class="my-2" />

                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.subtitle2">Tables & Fields</MudText>

                    <MudStack Row Spacing="1">
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Disabled="@(!_hasData || _selectedRole is null)"
                                   OnClick="@(async (MouseEventArgs _) => await SelectAllAsync())">
                            Select all
                        </MudButton>

                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Disabled="@(!_hasData || _selectedRole is null)"
                                   OnClick="@(async (MouseEventArgs _) => await ClearAllAsync())">
                            Clear all
                        </MudButton>
                    </MudStack>
                </MudStack>

                <MudText Typo="Typo.caption" Color="Color.Surface">
                    Selected: @_selectedKeys.Count fields
                </MudText>

                <MudDivider Class="my-2" />

                @if (_isLoading)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (_selectedRole is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Select a role to load and edit access.
                    </MudText>
                }
                else if (!_hasData)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        No TableFieldDefinition rows found.
                    </MudText>
                }
                else
                {
                    <MudTextField @bind-Value="_filter"
                                  Dense="true"
                                  Placeholder="Filter tables/fields..."
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.FilterList" />

                    <MudDivider Class="my-2" />

                    <!-- LIST LOOK & FEEL (matches screenshot) -->
                    <MudPaper Elevation="0"
                              Class="pa-0"
                              Style="max-height: 520px; overflow:auto;">

                        <MudStack Spacing="2" Class="pa-2">
                            @foreach (var grp in FilteredGroups())
                            {
                                <MudStack Spacing="1" @key="grp.TableName">

                                    <!-- Table header -->
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">
                                        @grp.TableName
                                    </MudText>

                                    <MudDivider />

                                    <!-- Fields (indented) -->
                                    <MudStack Spacing="0" Style="padding-left: 24px;">
                                        @foreach (var f in grp.Fields)
                                        {
                                            <div @key="f.Key">
                                                <MudCheckBox T="bool"
                                                             Dense="true"
                                                             DisableRipple="true"
                                                             Color="Color.Primary"
                                                             Value="@_selectedKeys.Contains(f.Key)"
                                                             ValueChanged="@((bool v) => OnFieldCheckedChanged(f.Key, v))">
                                                    <MudText Typo="Typo.body2">@f.ColumnName</MudText>
                                                </MudCheckBox>
                                            </div>
                                        }
                                    </MudStack>

                                </MudStack>
                            }
                        </MudStack>

                    </MudPaper>
                }
            </MudStack>

        </MudPaper>
    </MudItem>

    <!-- RIGHT: Actions -->
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-3">

            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle2">Access Editor</MudText>

                
                <MudDivider Class="my-2" />

                <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@(!_canSave)"
                               OnClick="@(async (MouseEventArgs _) => await SaveAsync())">
                        Save
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Disabled="@(!_hasData || _selectedRole is null)"
                               OnClick="@(async (MouseEventArgs _) => await ReloadRoleAccessAsync())">
                        Reload
                    </MudButton>

                    @if (_selectedRole is not null)
                    {
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">
                            Role: @_selectedRole.Name
                        </MudChip>
                    }
@* 
                    @if (_lastLoadedCount >= 0)
                    {
                        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">
                            Loaded: @_lastLoadedCount saved rows
                        </MudChip>
                    } *@
                </MudStack>

    @*             @if (!string.IsNullOrWhiteSpace(_saveResultText))
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        @_saveResultText
                    </MudAlert>
                } *@
            </MudStack>

        </MudPaper>
    </MudItem>

</MudGrid>

@code {
    private List<Role> _roles = new();
    private Role? _selectedRole;

    private List<TableGroup> _groups = new();

    // Selected keys are "table|column"
    private HashSet<string> _selectedKeys = new(StringComparer.OrdinalIgnoreCase);

    private bool _isLoading = false;
    private string _filter = string.Empty;

    private int _lastLoadedCount = -1;
    private string? _saveResultText;

    private bool _hasData => _groups.Count > 0;
    private bool _canSave => !_isLoading && _selectedRole is not null && _hasData;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            _roles = await Db.Roles
                .AsNoTracking()
                .Where(r => r.IsActive)
                .OrderBy(r => r.Name)
                .ToListAsync();

            await LoadTableFieldDefinitionsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load page data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string MakeKey(string table, string column) => $"{table}|{column}";

    private async Task LoadTableFieldDefinitionsAsync()
    {
        var defs = await Db.TableFieldDefinitions
            .AsNoTracking()
            .OrderBy(x => x.table_name)
            .ThenBy(x => x.column_name)
            .ToListAsync();

        _groups = defs
            .GroupBy(d => d.table_name, StringComparer.OrdinalIgnoreCase)
            .Select(g => new TableGroup(
                g.Key,
                g.Select(x => new FieldNode(MakeKey(x.table_name, x.column_name), x.column_name))
                 .OrderBy(x => x.ColumnName)
                 .ToList()
            ))
            .OrderBy(g => g.TableName)
            .ToList();
    }

    private Task<IEnumerable<Role>> SearchRolesAsync(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_roles.AsEnumerable());

        var v = value.Trim();
        return Task.FromResult(_roles.Where(r => r.Name.Contains(v, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task OnRoleChangedAsync(Role? role)
    {
        _selectedRole = role;
        _saveResultText = null;
        _selectedKeys.Clear();
        _lastLoadedCount = -1;

        if (_selectedRole is null)
            return;

        await ReloadRoleAccessAsync();
    }

    private async Task ReloadRoleAccessAsync()
    {
        if (_selectedRole is null)
            return;

        _isLoading = true;
        try
        {
            var roleId = _selectedRole.RoleId;

            var existing = await Db.Set<AccessEntity>()
                .AsNoTracking()
                .Where(x => x.RoleId == roleId)
                .Select(x => new { x.TableName, x.ColumnName })
                .ToListAsync();

            _selectedKeys = existing
                .Select(x => MakeKey(x.TableName, x.ColumnName))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            _lastLoadedCount = existing.Count;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load role access: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnFieldCheckedChanged(string key, bool isChecked)
    {
        _saveResultText = null;

        if (isChecked)
            _selectedKeys.Add(key);
        else
            _selectedKeys.Remove(key);

        StateHasChanged();
    }

    private Task SelectAllAsync()
    {
        _saveResultText = null;

        foreach (var g in _groups)
            foreach (var f in g.Fields)
                _selectedKeys.Add(f.Key);

        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task ClearAllAsync()
    {
        _saveResultText = null;
        _selectedKeys.Clear();

        StateHasChanged();
        return Task.CompletedTask;
    }

    private IEnumerable<TableGroup> FilteredGroups()
    {
        var f = _filter?.Trim();
        if (string.IsNullOrWhiteSpace(f))
            return _groups;

        return _groups
            .Select(g =>
            {
                var fields = g.Fields
                    .Where(x => g.TableName.Contains(f, StringComparison.OrdinalIgnoreCase)
                             || x.ColumnName.Contains(f, StringComparison.OrdinalIgnoreCase))
                    .ToList();

                return new TableGroup(g.TableName, fields);
            })
            .Where(g => g.Fields.Count > 0);
    }

    private async Task SaveAsync()
    {
        if (_selectedRole is null)
            return;

        _isLoading = true;
        _saveResultText = null;

        try
        {
            Snackbar.Add($"Saving selections: {_selectedKeys.Count}", Severity.Normal);

            var roleId = _selectedRole.RoleId;
            var userId = await GetUserIdAsync();

            if (string.IsNullOrWhiteSpace(userId))
            {
                Snackbar.Add("UserId claim not found. Cannot save.", Severity.Error);
                return;
            }

            var accessSet = Db.Set<AccessEntity>();

            var existingRows = await accessSet
                .Where(x => x.RoleId == roleId)
                .ToListAsync();

            var existingKeys = existingRows
                .Select(x => MakeKey(x.TableName, x.ColumnName))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            var toDelete = existingRows
                .Where(x => !_selectedKeys.Contains(MakeKey(x.TableName, x.ColumnName)))
                .ToList();

            var toAddKeys = _selectedKeys.Where(k => !existingKeys.Contains(k)).ToList();
            var toAdd = new List<AccessEntity>(toAddKeys.Count);

            foreach (var key in toAddKeys)
            {
                var parts = key.Split('|', 2, StringSplitOptions.None);
                var table = parts.Length > 0 ? parts[0] : "";
                var col = parts.Length > 1 ? parts[1] : "";

                toAdd.Add(new AccessEntity
                {
                    RoleId = roleId,
                    TableName = table,
                    ColumnName = col,
                    UserId = userId,
                    CanRead = true,
                    CanWrite = false
                });
            }

            foreach (var row in existingRows.Where(x => _selectedKeys.Contains(MakeKey(x.TableName, x.ColumnName))))
            {
                row.UserId = userId;
                row.CanRead = true;
            }

            if (toDelete.Count > 0)
                accessSet.RemoveRange(toDelete);

            if (toAdd.Count > 0)
                await accessSet.AddRangeAsync(toAdd);

            var changed = await Db.SaveChangesAsync();

            _saveResultText = $"Saved. Added {toAdd.Count}, removed {toDelete.Count}. (EF changes: {changed})";
            Snackbar.Add(_saveResultText, Severity.Success);

            await ReloadRoleAccessAsync();
        }
        catch (DbUpdateException ex)
        {
            Snackbar.Add($"Save failed (DB): {ex.Message} | Inner: {ex.InnerException?.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<string?> GetUserIdAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated != true)
            return null;

        return user.FindFirst(AppClaimTypes.UserId)?.Value;
    }

    public sealed record FieldNode(string Key, string ColumnName);
    public sealed record TableGroup(string TableName, List<FieldNode> Fields);
}